<!DOCTYPE html>
<html lang="en">
   <head>
      <title>Flight Tracker</title>
      <meta charset="utf-8">
      <link href="/flighttracker.css" rel="stylesheet">
      <link href="https://fonts.googleapis.com/css2?family=Arimo&display=swap" rel="stylesheet">
   </head>

   <body>
    <h1>Flight Tracker</h1>
    <form action="/flights/track" method="POST">
    <label>Flight Number:</label>
    <input type="text" name="flightNumber" placeholder="e.g. AA123" required>
    <br>
    <label>Notes:</label>
    <input type="text" name="notes">
    <br>
    <button type="submit">Track Flight</button>
</form>
</body>

</html>